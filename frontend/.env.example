# Copie para .env.local e ajuste conforme o ambiente.
# URL base da API Spring Boot (sem barra no final).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Opcional: servidor de blocos do mapa (padrão: OpenStreetMap).
# Em produção, use um provedor próprio: o servidor público do OSM não é para uso intenso.
# NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
